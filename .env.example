# Server configuration
PORT=3000

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# AI Inventory Analyst Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Optional model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Production Security & Rate Limiting (express-rate-limit)
# Window duration in milliseconds (default: 15 minutes = 900000ms)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Maximum login and registration attempts per window (default: 10)
AUTH_RATE_LIMIT_MAX=10

# Reverse Proxy Trust (Express trust proxy setting)
# Required when deployed behind reverse proxies (Render, Fly.io, Heroku, AWS ALB, Nginx)
# Set to '1' for a single reverse proxy, or 'loopback' for local reverse proxies.
# Leave commented out or 'false' if running directly exposed without a proxy.
# TRUST_PROXY=1
